  "triggers": {
    "consolePhases": ["pr-opened", "ci", "review", "merge", "closed"],
    "adoEvents": ["git.pullrequest.created", "git.pullrequest.updated", "git.pullrequest.merged", "workitem.updated"]
  },
  "safety": { "mode": "observe" }
