{
  "schemaVersion": 1,
  "ownerName": "Your Name",
  "crossModelReviewAuthorized": false,
  "sharedResources": ["localhost:5432 (dev Postgres)"],
  "defaultVerificationEnvironment": "localhost",
  "implementationLevel": "full",
  "reviewRoundLimit": 3,
  "beforeAndAfter": "ask",
  "architectureDiagram": "ask",
  "workerPermissions": "restricted",
  "models": { "claude-code": { "deep": "opus", "standard": null } },
  "phaseTiers": {},
  "commandCenterPath": "/path/to/software-factory",
  "adapters": {},
  "repos": {
    "owner/name": {
      "gates": {
        "test": "npm test",
        "lint": "npm run lint",
        "typecheck": "npx tsc --noEmit",
        "build": "npm run build",
        "secrets": "gitleaks git --no-banner --log-opts={base}..HEAD",
        "dependencies": null,
        "staticAnalysis": null,
        "mutation": "npx stryker run --mutate {files}"
      },
      "branchPattern": "story/{id}-{slug}",
      "worktreeRoot": "/path/to/name-worktrees",
      "teamRules": ["https://example.com/team-handbook", "docs/review-guide.md", "Reply to every pull request comment before resolving it."],
      "readiness": { "tracker": "github", "checklist": ["prMergedToTarget", "prLinked", "userConfirm"] },
      "requiredPipelines": [],
      "reviewBot": "none",
      "specDir": "docs/specs"
    }
  }
}
